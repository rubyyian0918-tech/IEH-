# 複製這個檔案成 .env，再填入你自己的值。.env 不會被上傳到 GitHub。
# 所有帳號、金鑰、網址都放在這裡，不寫死在程式裡。

# ── Meta App（developers.facebook.com → 你的 App → 設定 → 基本資料）──
META_APP_ID=
META_APP_SECRET=
# Graph API 版本，請對照官方文件目前的最新版本
META_GRAPH_VERSION=v24.0

# ── Webhook ──
# 自己想一串隨機文字，同一串也要填到 Meta App 的 Webhooks 設定裡
WEBHOOK_VERIFY_TOKEN=
# 對外可連到這台電腦的 https 網址（例如 Cloudflare Tunnel 給你的網址），不含結尾斜線
PUBLIC_BASE_URL=
PORT=3000

# ── 測試對象（登入授權後，執行 npm run check -- pages 會列出可用的值）──
# 測試用粉專 ID
FB_PAGE_ID=
# 粉專連結的 Instagram 商業帳號 ID
IG_USER_ID=
# 廣告帳號 ID（不含 act_ 前綴）；沒有廣告可先留空
AD_ACCOUNT_ID=

# ── 安全 ──
# 用來加密儲存 token 的金鑰（64 個 0-9a-f 字元）。
# 產生方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENC_KEY=
# 設成 true 才會真的在平台上回覆／隱藏／刪除；只能對測試粉專使用
ALLOW_WRITE=false

# ── AI（console.anthropic.com 建立的 API 金鑰）──
ANTHROPIC_API_KEY=
# 分類用便宜的小模型；回覆建議用品質較好的模型。可自行替換後比較品質與成本
AI_CLASSIFY_MODEL=claude-haiku-4-5
AI_SUGGEST_MODEL=claude-opus-5-5
